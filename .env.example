# Required
GCP_PROJECT=shipsafe-ai
GEMINI_MODEL=gemini-2.5-flash

# Optional overrides (default: shipsafe_hormuz)
BQ_DATASET=hormuz_port_arrivals

# Write gate — set true only for RecoveryAgent after human approval
FIVETRAN_ALLOW_WRITES=false

# Webhook HMAC secret (stored in Secret Manager as WEBHOOK_SECRET)
# WEBHOOK_SECRET=...  # never set here — loaded from Secret Manager

# Public URL for webhook registration (set on Cloud Run deploy)
# TIDESYNC_PUBLIC_URL=https://tidesync-xxx-uc.a.run.app

# Staleness threshold in seconds (default: 3600 = 1 hour)
STALE_THRESHOLD_SECONDS=3600
